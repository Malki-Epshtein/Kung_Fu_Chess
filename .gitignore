# Visual Studio / MSVC
.vs/
*.obj
*.exe
*.pdb
*.user
*.aps
*.pch
*.vspscc
*.vssscc
build/
bin/
obj/
x64/
x86/
# Win32-platform builds land directly in Debug/ or Release/ (not nested
# under x86/), so those two patterns above don't catch them.
Debug/
Release/
*.ilk
*.idb
*.tlog/
*.recipe
*.lastbuildstate
*.FileListAbsolute.txt

# Editor-local, machine-specific (e.g. hardcoded absolute toolchain
# paths) - not useful to anyone else who clones the repo.
.vscode/

# Runtime-generated SQLite user database (Stage F) - created fresh by
# UserRepository on first run; never commit real account/password data.
users.db

# Runtime-generated log files (Log::init, shared/log/Log.h) - one per
# executable (server.log/client.log), created fresh next to the exe.
*.log