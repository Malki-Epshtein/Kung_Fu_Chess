# Unused side .vcxproj skeletons (not part of the build; superseded by the
# server/client/shared folders inside Kung_Fu_Chess/) - anchored to repo
# root so this doesn't match the in-use nested server/ and shared/ folders.
/Server/
/Shared/

# Runtime-generated SQLite user database (Stage F) - created fresh by
# UserRepository on first run; never commit real account/password data.
users.db